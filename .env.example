# Servidor
NODE_ENV=development
PORT=3333

# Banco (SQLite por padrao; troque a URL para Postgres em producao)
DATABASE_URL="file:./dev.db"

# Autenticacao
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="1d"

# Regras de negocio da biblioteca
LOAN_DAYS=14
MAX_ACTIVE_LOANS=3
FINE_PER_DAY=1.50
MAX_RENEWALS=1
